@@ -0,0 +1,242 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Vorssaint
+
+import AppKit
+import SwiftUI
+
+/// The island's Study page: the Study Timer app's session, drawn as Study
+/// Timer draws it. A progress ring with a breathing aura, the round dots, and
+/// pause, skip, stop and copy code. With no session it offers presets and the
+/// island's own pomodoro settings; with Study Timer closed, a way to open it.
+/// Every button is a command to Study Timer, which owns the session.
+struct NotchStudyTimerView: View {
+    let size: CGSize
+    @ObservedObject private var bridge = NotchStudyTimerBridge.shared
+    @State private var copied = false
+
+    static let preferredHeight: CGFloat = 156
+
+    var body: some View {
+        Group {
+            if !bridge.studyTimerRunning {
+                NotchEmptyView(symbol: "graduationcap", message: "Study Timer isn't open.") {
+                    NotchPillButton(title: "Open Study Timer", prominent: true) { bridge.openStudyTimer() }
+                }
+            } else if let session = bridge.session {
+                running(session)
+            } else {
+                setup
+            }
+        }
+        .frame(maxWidth: .infinity, maxHeight: .infinity)
+        .onAppear {
+            NotchStudyTimerBridge.shared.start()
+            NotchStudyTimerBridge.shared.ask()
+        }
+    }
+
+    // MARK: No session
+
+    private struct Preset: Identifiable {
+        let focus: Int, brk: Int, rounds: Int
+        var id: String { "\(focus)-\(brk)-\(rounds)" }
+    }
+
+    private var presets: [Preset] {
+        let own = NotchPomodoroConfiguration.load()
+        let island = Preset(focus: own.focusMinutes, brk: own.shortBreakMinutes, rounds: min(12, own.totalSessions))
+        let fixed = [Preset(focus: 25, brk: 5, rounds: 4), Preset(focus: 50, brk: 10, rounds: 3), Preset(focus: 90, brk: 15, rounds: 2)]
+        return fixed.contains(where: { $0.id == island.id }) ? fixed : [island] + fixed
+    }
+
+    private var setup: some View {
+        VStack(spacing: 14) {
+            HStack(spacing: 8) {
+                Image(systemName: "graduationcap").foregroundStyle(Self.color(0x8CCBFF))
+                Text("Start a study session").font(.system(size: 14, weight: .semibold)).foregroundStyle(.white)
+            }
+            HStack(spacing: 8) {
+                ForEach(presets) { preset in
+                    Button {
+                        bridge.send(.start, ["focus": preset.focus, "brk": preset.brk, "rounds": preset.rounds])
+                    } label: {
+                        VStack(spacing: 2) {
+                            Text("\(preset.focus) / \(preset.brk)")
+                                .font(.system(size: 13, weight: .semibold)).monospacedDigit()
+                            Text("×\(preset.rounds)")
+                                .font(.system(size: 10, weight: .medium)).monospacedDigit()
+                                .foregroundStyle(.white.opacity(0.55))
+                        }
+                        .foregroundStyle(.white)
+                        .frame(minWidth: 64)
+                        .padding(.vertical, 8)
+                        .background(.white.opacity(0.1), in: Capsule())
+                        .contentShape(Capsule())
+                    }
+                    .buttonStyle(NotchButtonStyle(cornerRadius: 18))
+                    .help("\(preset.focus) min focus, \(preset.brk) min break, \(preset.rounds) rounds")
+                }
+            }
+            Text("Runs in Study Timer, with its chimes and share code.")
+                .font(.system(size: 11)).foregroundStyle(.white.opacity(0.5))
+        }
+        .padding(.horizontal, 12)
+    }
+
+    // MARK: Running
+
+    private func running(_ session: NotchStudyTimerBridge.Session) -> some View {
+        TimelineView(.animation(minimumInterval: 1.0 / 30, paused: session.pausedAt != nil)) { context in
+            let wall = context.date.timeIntervalSince1970
+            let at = session.pausedAt ?? wall
+            let phase = NotchStudyTimerBridge.phase(session, at: at)
+            content(session, phase: phase, wall: wall, at: at)
+        }
+    }
+
+    @ViewBuilder
+    private func content(_ s: NotchStudyTimerBridge.Session, phase: NotchStudyTimerBridge.Phase?,
+                         wall: TimeInterval, at: TimeInterval) -> some View {
+        let paused = s.pausedAt != nil
+        let waiting = phase == nil && at < s.start
+        let finished = phase == nil && !waiting
+        let tint = finished ? Self.color(0xFFD58C) : waiting ? Self.color(0xB9A7FF)
+            : phase?.focus == true ? Self.color(0x8CCBFF) : Self.color(0x7FE6C5)
+        let length = Double((phase?.focus ?? true ? s.focus : s.brk) * 60)
+        let progress = finished ? 1 : waiting ? 0 : min(1, max(0, 1 - (phase?.remaining ?? 0) / max(1, length)))
+        let remaining = waiting ? s.start - at : (phase?.remaining ?? 0)
+        let diameter = max(84, min(size.height - 20, 128))
+
+        HStack(spacing: 20) {
+            ring(diameter: diameter, progress: progress, tint: tint, paused: paused,
+                 breath: Self.breath(elapsed: at - s.start, remaining: remaining, active: phase != nil),
+                 reading: finished ? "done" : Self.clock(remaining))
+
+            VStack(alignment: .leading, spacing: 9) {
+                HStack(spacing: 8) {
+                    Text(paused ? "paused" : finished ? "session complete" : waiting ? "starts soon"
+                         : phase?.focus == true ? "focus" : "break")
+                        .font(.system(size: 14, weight: .semibold))
+                        .foregroundStyle(paused ? Color.white.opacity(0.6) : tint)
+                    Text(String(format: "round %02d / %02d", phase?.round ?? (finished ? s.rounds : 1), s.rounds))
+                        .font(.system(size: 11, weight: .medium, design: .monospaced))
+                        .foregroundStyle(.white.opacity(0.5))
+                }
+                Text(Self.nextLine(s, phase: phase, finished: finished, waiting: waiting, paused: paused, wall: wall))
+                    .font(.system(size: 12)).foregroundStyle(.white.opacity(0.6))
+                    .lineLimit(1)
+                dots(s, phase: phase, finished: finished, tint: tint)
+                controls(s, finished: finished, paused: paused)
+            }
+            Spacer(minLength: 0)
+        }
+        .padding(.horizontal, 14)
+    }
+
+    private func ring(diameter: CGFloat, progress: Double, tint: Color, paused: Bool,
+                      breath: Double, reading: String) -> some View {
+        ZStack {
+            Circle()
+                // Kept inside the island at its fullest breath, so the
+                // island's edges never seem to move as it breathes.
+                .fill(RadialGradient(gradient: Gradient(colors: [tint, tint.opacity(0)]),
+                                     center: .center, startRadius: 0, endRadius: diameter * 0.6))
+                .frame(width: diameter * 1.2, height: diameter * 1.2)
+                .scaleEffect(paused ? 0.9 : 0.9 + 0.14 * breath)
+                .opacity(paused ? 0.15 : 0.25 + 0.35 * breath)
+                .blur(radius: 12)
+                .allowsHitTesting(false)
+            Circle().stroke(.white.opacity(0.12), lineWidth: 6)
+            Circle()
+                .trim(from: 0, to: progress)
+                .stroke(tint, style: StrokeStyle(lineWidth: 6, lineCap: .round))
+                .rotationEffect(.degrees(-90))
+                .shadow(color: tint.opacity(0.6), radius: 5)
+            Text(reading)
+                .font(.system(size: diameter * 0.21, weight: .semibold, design: .monospaced))
+                .monospacedDigit()
+                .foregroundStyle(paused ? Color.white.opacity(0.55) : Color.white)
+                .lineLimit(1).minimumScaleFactor(0.6)
+                .padding(.horizontal, 10)
+        }
+        .frame(width: diameter, height: diameter)
+        .accessibilityElement(children: .combine)
+    }
+
+    private func dots(_ s: NotchStudyTimerBridge.Session, phase: NotchStudyTimerBridge.Phase?,
+                      finished: Bool, tint: Color) -> some View {
+        HStack(spacing: 7) {
+            ForEach(1...max(1, s.rounds), id: \.self) { round in
+                let done = finished || (phase.map { round < $0.round || (round == $0.round && !$0.focus) } ?? false)
+                let current = !finished && phase?.round == round && phase?.focus == true
+                Circle()
+                    .fill(done ? Color.white : current ? tint : Color.clear)
+                    .overlay(Circle().strokeBorder(done || current ? Color.clear : Color.white.opacity(0.3), lineWidth: 1))
+                    .frame(width: 8, height: 8)
+                    .shadow(color: current ? tint : .clear, radius: 4)
+            }
+        }
+        .accessibilityHidden(true)
+    }
+
+    @ViewBuilder
+    private func controls(_ s: NotchStudyTimerBridge.Session, finished: Bool, paused: Bool) -> some View {
+        HStack(spacing: 6) {
+            if finished {
+                NotchPillButton(title: "Go again", prominent: true) {
+                    bridge.send(.start, ["focus": s.focus, "brk": s.brk, "rounds": s.rounds])
+                }
+                NotchPillButton(title: "Done") { bridge.send(.end) }
+            } else {
+                NotchIconButton(symbol: paused ? "play.fill" : "pause.fill", title: paused ? "Resume" : "Pause") {
+                    bridge.send(.togglePause)
+                }
+                NotchIconButton(symbol: "forward.end.fill", title: "Skip to next phase") { bridge.send(.skip) }
+                NotchIconButton(symbol: "stop.fill", title: "End session") { bridge.send(.end) }
+                if let code = bridge.code {
+                    NotchPillButton(title: copied ? "Copied" : "Copy code") {
+                        NSPasteboard.general.clearContents()
+                        NSPasteboard.general.setString(code, forType: .string)
+                        copied = true
+                        DispatchQueue.main.asyncAfter(deadline: .now() + 1.5) { copied = false }
+                    }
+                    .help("Copy the share code so a friend can study in sync")
+                }
+            }
+        }
+    }
+
+    // MARK: Helpers (Study Timer's own rules)
+
+    /// One breath every 6 seconds, every 2 in a phase's last minute, on the session clock.
+    static func breath(elapsed: TimeInterval, remaining: TimeInterval, active: Bool) -> Double {
+        let cycle = active && remaining <= 60 ? 2.0 : 6.0
+        return (1 - cos(2 * Double.pi * elapsed / cycle)) / 2
+    }
+
+    static func clock(_ seconds: TimeInterval) -> String {
+        let total = max(0, Int(seconds.rounded(.up)))
+        let h = total / 3600, m = (total % 3600) / 60, s = total % 60
+        return h > 0 ? String(format: "%d:%02d:%02d", h, m, s) : String(format: "%02d:%02d", m, s)
+    }
+
+    static func nextLine(_ s: NotchStudyTimerBridge.Session, phase: NotchStudyTimerBridge.Phase?,
+                         finished: Bool, waiting: Bool, paused: Bool, wall: TimeInterval) -> String {
+        if finished { return "\(NotchStudyTimerBridge.minutes(s.rounds * s.focus)) focused" }
+        if paused { return "press play to resume" }
+        if waiting { return "starts at \(time(s.start))" }
+        guard let phase else { return "" }
+        let ends = time(wall + phase.remaining)
+        if phase.focus { return phase.round == s.rounds ? "ends at \(ends)" : "\(s.brk) min break at \(ends)" }
+        return "round \(phase.round + 1) at \(ends)"
+    }
+
+    static func time(_ epoch: TimeInterval) -> String {
+        Date(timeIntervalSince1970: epoch).formatted(date: .omitted, time: .shortened).lowercased()
+    }
+
+    static func color(_ hex: UInt32) -> Color {
+        Color(.sRGB, red: Double((hex >> 16) & 0xFF) / 255, green: Double((hex >> 8) & 0xFF) / 255,
+              blue: Double(hex & 0xFF) / 255, opacity: 1)
+    }
+}
