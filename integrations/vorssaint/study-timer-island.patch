diff --git a/Sources/Vorssaint/Services/Notch/NotchTimerSupport.swift b/Sources/Vorssaint/Services/Notch/NotchTimerSupport.swift
index cf5f6fc..e6b27e6 100644
--- a/Sources/Vorssaint/Services/Notch/NotchTimerSupport.swift
+++ b/Sources/Vorssaint/Services/Notch/NotchTimerSupport.swift
@@ -169,6 +169,25 @@ struct NotchTimerSession: Equatable {
     }
 
     mutating func cancel() { self = Self() }
+
+    /// A read-only copy of one Study Timer phase (see NotchStudyTimerBridge):
+    /// a pomodoro showing the right phase, round and time left.
+    static func mirrored(focus: Bool, minutes: Int, remaining: TimeInterval, paused: Bool,
+                         round: Int, rounds: Int, focusMinutes: Int, breakMinutes: Int,
+                         now: TimeInterval) -> Self {
+        var session = Self()
+        session.mode = .pomodoro
+        session.phase = focus ? .focus : .shortBreak
+        session.configuration = NotchPomodoroConfiguration(
+            focusMinutes: focusMinutes, shortBreakMinutes: breakMinutes, longBreakMinutes: breakMinutes,
+            longBreakInterval: rounds, totalSessions: rounds)
+        session.duration = Double(max(1, minutes)) * 60
+        // sessionNumber then reads as the round: a focus adds one for itself.
+        session.completedFocuses = max(0, round - 1) + (focus ? 0 : 1)
+        let left = max(0, min(remaining, session.duration))
+        if paused { session.pausedReading = left } else if now.isFinite { session.anchor = now + left }
+        return session
+    }
 }
 
 enum NotchTimerSupport {
