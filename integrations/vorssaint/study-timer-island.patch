diff --git a/Sources/Vorssaint/Services/Notch/NotchStudyTimerBridge.swift b/Sources/Vorssaint/Services/Notch/NotchStudyTimerBridge.swift
new file mode 100644
index 0000000..fa23f47
--- /dev/null
+++ b/Sources/Vorssaint/Services/Notch/NotchStudyTimerBridge.swift
@@ -0,0 +1,247 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Vorssaint
+
+import AppKit
+import Combine
+
+/// Shows a session from the Study Timer menu bar app in the island: the Study
+/// page (NotchStudyTimerView) and the timer strip. Study Timer broadcasts its session (start time, focus and break
+/// lengths, rounds, pause) as a distributed notification; the island mirrors
+/// the current phase as a read-only pomodoro and sends the strip's pause, skip
+/// and stop back to Study Timer. A timer started in Vorssaint always wins: a
+/// mirror never replaces it.
+final class NotchStudyTimerBridge: ObservableObject {
+    static let shared = NotchStudyTimerBridge()
+    static let stateNotification = Notification.Name("com.braxtonhauw.studytimer.state")
+    static let requestNotification = Notification.Name("com.braxtonhauw.studytimer.request")
+    static let commandNotification = Notification.Name("com.braxtonhauw.studytimer.command")
+
+    enum Command: String { case togglePause, skip, end, start }
+
+    struct Session: Equatable {
+        let focus: Int        // minutes
+        let brk: Int          // minutes
+        let rounds: Int
+        let start: TimeInterval     // seconds since 1970
+        let pausedAt: TimeInterval?
+    }
+
+    struct Phase: Equatable {
+        let focus: Bool
+        let round: Int
+        let remaining: TimeInterval
+    }
+
+    struct Notice: Equatable {
+        let title: String
+        let detail: String
+        let symbol: String
+    }
+
+    private var stateObserver: NSObjectProtocol?
+    private var wakeObserver: NSObjectProtocol?
+    @Published private(set) var session: Session?
+    /// The session's share code, for the Study page's Copy button.
+    @Published private(set) var code: String?
+    private var boundary: DispatchWorkItem?
+    /// The phase last shown, so a change can be announced like a finished agent task.
+    private var lastKey: String?
+    /// Study Timer answered or announced itself and has not quit since, so a
+    /// pomodoro started here runs there.
+    @Published private(set) var studyTimerRunning = false
+    private var pendingStart: DispatchWorkItem?
+    private init() {}
+
+    func start() {
+        guard stateObserver == nil else { return }
+        stateObserver = DistributedNotificationCenter.default().addObserver(
+            forName: Self.stateNotification, object: nil, queue: .main) { [weak self] note in
+            self?.receive(note.userInfo)
+        }
+        // Wall time and the island's clock can part ways across sleep.
+        wakeObserver = NSWorkspace.shared.notificationCenter.addObserver(
+            forName: NSWorkspace.didWakeNotification, object: nil, queue: .main) { [weak self] _ in
+            self?.reapply()
+        }
+        ask()
+    }
+
+    /// A Study Timer that is running repeats its session.
+    func ask() {
+        DistributedNotificationCenter.default().postNotificationName(
+            Self.requestNotification, object: nil, userInfo: nil, deliverImmediately: true)
+    }
+
+    /// Opens Study Timer, or its download page when it is not installed.
+    func openStudyTimer() {
+        if let url = NSWorkspace.shared.urlForApplication(withBundleIdentifier: Self.studyTimerBundleID) {
+            NSWorkspace.shared.openApplication(at: url, configuration: NSWorkspace.OpenConfiguration(), completionHandler: nil)
+        } else if let url = URL(string: "https://github.com/wl3512-lab/study-timer/releases") {
+            NSWorkspace.shared.open(url)
+        }
+    }
+
+    static let studyTimerBundleID = "com.braxtonhauw.studytimerbar"
+
+    func stop() {
+        if let stateObserver { DistributedNotificationCenter.default().removeObserver(stateObserver) }
+        if let wakeObserver { NSWorkspace.shared.notificationCenter.removeObserver(wakeObserver) }
+        stateObserver = nil
+        wakeObserver = nil
+        boundary?.cancel(); boundary = nil
+        session = nil
+        code = nil
+        lastKey = nil
+        studyTimerRunning = false
+        pendingStart?.cancel(); pendingStart = nil
+    }
+
+    func send(_ command: Command, _ extra: [String: Any] = [:]) {
+        var info = extra
+        info["action"] = command.rawValue
+        DistributedNotificationCenter.default().postNotificationName(
+            Self.commandNotification, object: nil, userInfo: info, deliverImmediately: true)
+    }
+
+    /// Starts a Study Timer session with the island's pomodoro settings. False
+    /// when Study Timer is not running, so the island's own timer starts instead.
+    /// Study Timer has no long breaks: its rounds are the pomodoro's sessions.
+    func startStudySession(_ configuration: NotchPomodoroConfiguration) -> Bool {
+        guard studyTimerRunning else { return false }
+        send(.start, Self.startInfo(configuration))
+        // Study Timer answers with its new session. If it never does (it
+        // quit without saying so), the island's own pomodoro starts instead.
+        pendingStart?.cancel()
+        let fallback = DispatchWorkItem { [weak self] in
+            guard let self else { return }
+            self.pendingStart = nil
+            self.studyTimerRunning = false
+            NotchTimerService.shared.start(mode: .pomodoro, minutes: configuration.focusMinutes)
+        }
+        pendingStart = fallback
+        DispatchQueue.main.asyncAfter(deadline: .now() + 2, execute: fallback)
+        return true
+    }
+
+    static func startInfo(_ c: NotchPomodoroConfiguration) -> [String: Any] {
+        ["focus": min(180, max(1, c.focusMinutes)),
+         "brk": min(60, max(1, c.shortBreakMinutes)),
+         "rounds": min(12, max(1, c.totalSessions))]
+    }
+
+    private func receive(_ info: [AnyHashable: Any]?) {
+        studyTimerRunning = info?["quitting"] as? Bool != true
+        if Self.session(from: info) != nil { pendingStart?.cancel(); pendingStart = nil }
+        session = Self.session(from: info)
+        code = session == nil ? nil : info?["code"] as? String
+        reapply()
+    }
+
+    /// Mirrors the current phase and waits for the next boundary.
+    func reapply() {
+        boundary?.cancel(); boundary = nil
+        let timer = NotchTimerService.shared
+        guard let session else { lastKey = nil; timer.endMirror(); return }
+        let wall = Date().timeIntervalSince1970
+        let current = Self.phase(session, at: session.pausedAt ?? wall)
+        let key = Self.key(session, phase: current, wall: wall)
+        if let notice = Self.notice(key: key, previous: lastKey, session: session, phase: current,
+                                    elapsed: wall - session.start) {
+            _ = NotchService.shared.show(NotchNotice(event: .timer, title: notice.title,
+                                                     detail: notice.detail, symbol: notice.symbol))
+            // The companion cheers a finished session, as it does a finished agent task.
+            if key == "done" { NotchService.shared.reactMascot(.celebrate) }
+        }
+        lastKey = key
+        guard let phase = current else {
+            timer.endMirror()
+            // Not started yet: come back when it starts.
+            if session.pausedAt == nil, wall < session.start { schedule(after: session.start - wall) }
+            return
+        }
+        timer.mirror(.mirrored(focus: phase.focus, minutes: phase.focus ? session.focus : session.brk,
+                               remaining: phase.remaining, paused: session.pausedAt != nil,
+                               round: phase.round, rounds: session.rounds,
+                               focusMinutes: session.focus, breakMinutes: session.brk, now: timer.now))
+        if session.pausedAt == nil { schedule(after: phase.remaining) }
+    }
+
+    private func schedule(after seconds: TimeInterval) {
+        let work = DispatchWorkItem { [weak self] in self?.reapply() }
+        boundary = work
+        DispatchQueue.main.asyncAfter(deadline: .now() + max(0, seconds) + 0.25, execute: work)
+    }
+
+    /// The broadcast's userInfo, or nil when no session is running.
+    static func session(from info: [AnyHashable: Any]?) -> Session? {
+        guard let info, info["active"] as? Bool == true,
+              let focus = (info["focus"] as? NSNumber)?.intValue,
+              let brk = (info["brk"] as? NSNumber)?.intValue,
+              let rounds = (info["rounds"] as? NSNumber)?.intValue,
+              let start = (info["startUtc"] as? NSNumber)?.doubleValue,
+              (1...180).contains(focus), (1...60).contains(brk), (1...24).contains(rounds), start.isFinite
+        else { return nil }
+        let paused = (info["pausedAt"] as? NSNumber)?.doubleValue ?? 0
+        return Session(focus: focus, brk: brk, rounds: rounds, start: start,
+                       pausedAt: paused > 0 && paused.isFinite ? paused : nil)
+    }
+
+    /// Names a moment of the session: "waiting", "focus-2", "break-1-paused", "done".
+    static func key(_ s: Session, phase: Phase?, wall: TimeInterval) -> String {
+        guard let phase else { return wall < s.start ? "waiting" : "done" }
+        return "\(phase.focus ? "focus" : "break")-\(phase.round)" + (s.pausedAt != nil ? "-paused" : "")
+    }
+
+    /// What the island says when a Study Timer session changes. Nil keeps it
+    /// quiet: the same moment again, or a session already under way when it
+    /// was first seen (Vorssaint opening mid-session).
+    static func notice(key: String, previous: String?, session s: Session, phase: Phase?,
+                       elapsed: TimeInterval) -> Notice? {
+        guard key != previous else { return nil }
+        guard let previous else {
+            guard let phase, phase.focus, phase.round == 1, s.pausedAt == nil, elapsed < 10 else { return nil }
+            return Notice(title: "Study session started", detail: "\(s.focus) min focus · \(s.rounds) rounds",
+                          symbol: "timer")
+        }
+        if key == "done" {
+            guard previous != "waiting" else { return nil }
+            return Notice(title: "Study session complete",
+                          detail: "\(s.rounds) rounds · \(Self.minutes(s.rounds * s.focus)) focused",
+                          symbol: "checkmark.circle")
+        }
+        guard let phase else { return nil }
+        if previous == "waiting" {
+            return Notice(title: "Study session started", detail: "\(s.focus) min focus · \(s.rounds) rounds",
+                          symbol: "timer")
+        }
+        let round = "Round \(phase.round) of \(s.rounds)"
+        if key.hasSuffix("-paused") {
+            return Notice(title: "Study timer paused", detail: round, symbol: "pause.circle")
+        }
+        if previous == key + "-paused" {
+            return Notice(title: "Study timer resumed", detail: round, symbol: "play.circle")
+        }
+        return phase.focus
+            ? Notice(title: "Back to focus", detail: "\(round) · \(s.focus) min", symbol: "brain.head.profile")
+            : Notice(title: "Break time", detail: "\(round) done · \(s.brk) min break", symbol: "cup.and.saucer")
+    }
+
+    static func minutes(_ total: Int) -> String {
+        total < 60 ? "\(total) min" : total % 60 == 0 ? "\(total / 60) h" : "\(total / 60) h \(total % 60) min"
+    }
+
+    /// Study Timer's schedule: each round is focus then break, and the last
+    /// round has no break. Nil before the start and after the last focus.
+    static func phase(_ s: Session, at now: TimeInterval) -> Phase? {
+        let focus = Double(s.focus * 60)
+        let cycle = Double((s.focus + s.brk) * 60)
+        let total = Double(s.rounds) * focus + Double(s.rounds - 1) * Double(s.brk * 60)
+        let elapsed = now - s.start
+        guard elapsed.isFinite, elapsed >= 0, elapsed < total else { return nil }
+        let index = (elapsed / cycle).rounded(.down)
+        let into = elapsed - index * cycle
+        return into < focus
+            ? Phase(focus: true, round: Int(index) + 1, remaining: focus - into)
+            : Phase(focus: false, round: Int(index) + 1, remaining: cycle - into)
+    }
+}
